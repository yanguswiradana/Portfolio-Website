---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page not found">
  <main id="main" class="container-page flex min-h-screen flex-col items-center justify-center text-center">
    <h1 class="text-6xl font-semibold">404</h1>
    <p class="mt-4 text-secondary">This page doesn't exist.</p>
    <a href="/" class="mt-8 text-accent hover:text-accent-hover">← Back home</a>
  </main>
</BaseLayout>
