---
import TerminalLayout from '~/layouts/TerminalLayout.astro';
import TerminalPage from '~/components/TerminalPage.astro';
import profileId from '~/data/id/profile.json';
import { SITE_URL } from '~/consts';
---

<TerminalLayout
  title={profileId.seo.title}
  description={profileId.seo.description}
  ogImage={`${SITE_URL}${profileId.seo.ogImage || '/og.png'}`}
  locale="id"
>
  <TerminalPage locale="id" />
</TerminalLayout>
