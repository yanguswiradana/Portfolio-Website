---
import BaseLayout from '~/layouts/BaseLayout.astro';
import profileId from '~/data/id/profile.json';
import { translations } from '~/lib/translations';

const t = translations.id;
---

<BaseLayout title={t.pageNotFound} description={t.pageNotFoundDesc} locale="id">
  <main
    id="main"
    class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 text-center"
  >
    <!-- Background glow blobs -->
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/10 blur-[120px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute left-1/4 top-1/3 -z-10 h-64 w-64 rounded-full bg-purple-500/8 blur-[80px]"
      aria-hidden="true"
    ></div>

    <!-- 404 number with gradient -->
    <p
      class="bg-gradient-to-br from-white/10 via-white/5 to-transparent bg-clip-text text-[10rem] font-black leading-none tracking-tight text-transparent select-none md:text-[14rem]"
      aria-hidden="true"
    >
      404
    </p>

    <!-- Content -->
    <div class="-mt-4 space-y-4">
      <h1 class="text-2xl font-bold text-white md:text-3xl">
        {t.pageNotFoundTitle}
      </h1>
      <p class="mx-auto max-w-sm text-zinc-500">
        {t.pageNotFoundSubtitle}
      </p>
    </div>

    <!-- CTA -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/id"
        class="inline-flex items-center gap-2 rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-zinc-950 shadow-lg shadow-accent/20 transition-all hover:-translate-y-0.5 hover:bg-accent/90 hover:shadow-accent/30"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        {t.backHome}
      </a>
      <a
        href={`mailto:${profileId.email}`}
        class="inline-flex items-center gap-2 rounded-xl border border-subtle bg-elevated px-6 py-3 text-sm font-semibold text-zinc-300 transition-all hover:-translate-y-0.5 hover:border-white/20 hover:text-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        {t.contact}
      </a>
    </div>
  </main>
</BaseLayout>
