---
import TerminalLayout from '~/layouts/TerminalLayout.astro';
import { getCollection } from 'astro:content';
import { translations } from '~/lib/translations';
import { renderPostContent } from '~/lib/render-post';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(
    (post) => post.data.locale === 'en'
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const locale = 'en';
const t = translations[locale];
const renderedContent = renderPostContent(post.data.content);
const date = new Date(post.data.publishedDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<TerminalLayout title={`${post.data.title} — Blog`} description={post.data.summary} locale={locale}>
  <article class="t-wrap t-article">
    <p class="t-links-row"><a href="/blog">&lt;- {t.blog}</a></p>
    <p class="t-prompt-line"><span class="t-prompt">guest@wiradana</span><span class="t-path">:~/blog</span><span class="t-cmd">$ cat {Astro.params.slug}.md</span></p>
    <p class="t-article-meta">{t.publishedOn} {date}</p>
    <h1>{post.data.title}</h1>
    <p class="t-article-summary">{post.data.summary}</p>
    {post.data.githubUrl && (
      <p class="t-links-row">
        <a href={post.data.githubUrl} target="_blank" rel="noopener noreferrer">view repository on github -&gt;</a>
      </p>
    )}
    <div class="t-prose" set:html={renderedContent} />
  </article>
</TerminalLayout>
