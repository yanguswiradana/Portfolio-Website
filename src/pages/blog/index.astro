---
import TerminalLayout from '~/layouts/TerminalLayout.astro';
import { getCollection } from 'astro:content';
import profileEn from '~/data/en/profile.json';
import { translations } from '~/lib/translations';

const locale = 'en';
const t = translations[locale];

const posts = (await getCollection('posts'))
  .filter((post) => post.data.locale === locale)
  .sort(
    (a, b) =>
      new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
  );
---

<TerminalLayout title={`${t.blog} — wiradana.dev`} description={t.blogSubtitle} locale={locale}>
  <div class="t-wrap t-article">
    <p class="t-links-row"><a href="/#blog">&lt;- {t.backHome}</a></p>
    <p class="t-prompt-line"><span class="t-prompt">guest@wiradana</span><span class="t-path">:~/blog</span><span class="t-cmd">$ ls</span></p>
    <h1>{t.blog}</h1>
    <p class="t-article-summary">{t.blogSubtitle}</p>
    {posts.length === 0 ? (
      <p class="t-dim">{t.emptyBlog}</p>
    ) : (
      posts.map((post) => (
        <article class="t-post">
          <p class="t-post-date">{post.data.publishedDate}</p>
          <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
          <p>{post.data.summary}</p>
          <p class="t-links-row"><a href={`/blog/${post.id}`}>{t.readMore} -&gt;</a></p>
        </article>
      ))
    )}
  </div>
</TerminalLayout>
