---
import TerminalLayout from '~/layouts/TerminalLayout.astro';
import TerminalPage from '~/components/TerminalPage.astro';
import profileEn from '~/data/en/profile.json';
import { SITE_URL } from '~/consts';
---

<TerminalLayout
  title={profileEn.seo.title}
  description={profileEn.seo.description}
  ogImage={`${SITE_URL}${profileEn.seo.ogImage || '/og.png'}`}
  locale="en"
>
  <TerminalPage locale="en" />
</TerminalLayout>
