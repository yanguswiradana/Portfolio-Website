---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';

interface Props {
  endpoint: string;
  email: string;
}

const { endpoint, email } = Astro.props;
---

<form
  id="contact-form"
  x-data={`{
    loading: false,
    success: false,
    error: false,
    async submit(event) {
      this.loading = true;
      this.success = false;
      this.error = false;

      const form = event.target;
      const data = new FormData(form);

      // honeypot check
      if (data.get('_gotcha')?.length) {
        form.reset();
        this.loading = false;
        return;
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.reset();
          this.success = true;
          setTimeout(() => { this.success = false; }, 8000);
        } else {
          throw new Error('HTTP ' + res.status);
        }
      } catch {
        this.error = true;
      } finally {
        this.loading = false;
      }
    }
  }`}
  action={endpoint}
  method="POST"
  x-on:submit.prevent="submit($event)"
  class="space-y-5"
  novalidate
>
  <div>
    <label for="cf-name" class="mb-2 block text-sm font-medium text-white">
      Name
    </label>
    <input
      type="text"
      id="cf-name"
      name="name"
      required
      minlength="2"
      maxlength="100"
      autocomplete="name"
      class="w-full rounded-lg border border-subtle bg-elevated px-4 py-2.5 text-sm text-white placeholder:text-zinc-600 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/50 transition-colors"
      placeholder="Your name"
    />
  </div>

  <div>
    <label for="cf-email" class="mb-2 block text-sm font-medium text-white">
      Email
    </label>
    <input
      type="email"
      id="cf-email"
      name="email"
      required
      autocomplete="email"
      class="w-full rounded-lg border border-subtle bg-elevated px-4 py-2.5 text-sm text-white placeholder:text-zinc-600 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/50 transition-colors"
      placeholder="you@example.com"
    />
  </div>

  <div>
    <label for="cf-message" class="mb-2 block text-sm font-medium text-white">
      Message
    </label>
    <textarea
      id="cf-message"
      name="message"
      required
      minlength="10"
      maxlength="2000"
      rows="5"
      class="w-full resize-y rounded-lg border border-subtle bg-elevated px-4 py-2.5 text-sm text-white placeholder:text-zinc-600 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/50 transition-colors"
      placeholder="What's on your mind?"
    ></textarea>
  </div>

  <!-- Honeypot -->
  <input
    type="text"
    name="_gotcha"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="absolute -left-[9999px] h-0 w-0 opacity-0"
  />

  <div class="flex flex-wrap items-center justify-between gap-4">
    <button
      type="submit"
      :disabled="loading"
      class="inline-flex items-center justify-center gap-2 rounded-lg bg-purple-700 px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-purple-600 disabled:cursor-not-allowed disabled:opacity-60"
    >
      <span x-show="!loading" class="inline-flex items-center gap-2">
        Send Message
        <Icon name="lucide:send" width={16} height={16} aria-hidden="true" />
      </span>
      <span x-show="loading" class="inline-flex items-center gap-2">
        <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-opacity="0.25" />
          <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" />
        </svg>
        Sending…
      </span>
    </button>
    <p class="text-xs text-zinc-600">Powered by Formspree</p>
  </div>

  <!-- Success -->
  <div
    x-show="success"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-400"
    role="status"
  >
    ✅ Thanks! I'll get back to you within 48 hours.
  </div>

  <!-- Error -->
  <div
    x-show="error"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400"
    role="alert"
  >
    ❌ Something went wrong. Please try again or
    <a href={`mailto:${email}`} class="underline hover:text-red-300">email me directly</a>.
  </div>
</form>
