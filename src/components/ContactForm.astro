---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';

interface Props {
  endpoint: string;
  email: string;
}

const { endpoint, email } = Astro.props;
---

<form
  id="contact-form"
  action={endpoint}
  method="POST"
  class="space-y-5"
  novalidate
>
  <div>
    <label for="cf-name" class="mb-2 block text-sm font-medium text-primary">
      Name
    </label>
    <input
      type="text"
      id="cf-name"
      name="name"
      required
      minlength="2"
      maxlength="100"
      autocomplete="name"
      class="w-full rounded-md border border-subtle bg-elevated px-3 py-2.5 text-sm text-primary placeholder:text-muted focus:border-accent focus:outline-none"
      placeholder="Your name"
    />
  </div>

  <div>
    <label for="cf-email" class="mb-2 block text-sm font-medium text-primary">
      Email
    </label>
    <input
      type="email"
      id="cf-email"
      name="email"
      required
      autocomplete="email"
      class="w-full rounded-md border border-subtle bg-elevated px-3 py-2.5 text-sm text-primary placeholder:text-muted focus:border-accent focus:outline-none"
      placeholder="you@example.com"
    />
  </div>

  <div>
    <label
      for="cf-message"
      class="mb-2 block text-sm font-medium text-primary"
    >
      Message
    </label>
    <textarea
      id="cf-message"
      name="message"
      required
      minlength="10"
      maxlength="2000"
      rows="5"
      class="w-full resize-y rounded-md border border-subtle bg-elevated px-3 py-2.5 text-sm text-primary placeholder:text-muted focus:border-accent focus:outline-none"
      placeholder="What's on your mind?"
    ></textarea>
  </div>

  <input
    type="text"
    name="_gotcha"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="absolute -left-[9999px] h-0 w-0 opacity-0"
  />

  <div class="flex flex-wrap items-center justify-between gap-4">
    <Button type="submit" variant="primary" size="md" id="cf-submit">
      <span class="cf-label inline-flex items-center gap-2">
        Send Message
        <Icon name="lucide:send" width={16} height={16} aria-hidden="true" />
      </span>
      <span class="cf-loading hidden items-center gap-2">
        <svg
          class="h-4 w-4 animate-spin"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="3"
            fill="none"
            stroke-opacity="0.25"
          />
          <path
            d="M12 2a10 10 0 0 1 10 10"
            stroke="currentColor"
            stroke-width="3"
            fill="none"
            stroke-linecap="round"
          />
        </svg>
        Sending…
      </span>
    </Button>
    <p class="text-xs text-muted">Powered by Formspree</p>
  </div>

  <div
    id="cf-success"
    class="hidden rounded-md border border-success/30 bg-success/10 px-4 py-3 text-sm text-success"
    role="status"
  >
    Thanks! I'll get back to you within 48 hours.
  </div>

  <div
    id="cf-error"
    class="hidden rounded-md border border-error/30 bg-error/10 px-4 py-3 text-sm text-error"
    role="alert"
  >
    Something went wrong. Please try again or
    <a href={`mailto:${email}`} class="underline">email me directly</a>.
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submit = document.getElementById('cf-submit') as HTMLButtonElement | null;
  const success = document.getElementById('cf-success');
  const error = document.getElementById('cf-error');

  if (form && submit) {
    const label = submit.querySelector('.cf-label') as HTMLElement | null;
    const loading = submit.querySelector('.cf-loading') as HTMLElement | null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      success?.classList.add('hidden');
      error?.classList.add('hidden');

      const data = new FormData(form);

      if ((data.get('_gotcha') as string | null)?.length) {
        form.reset();
        return;
      }

      if (label) label.classList.add('hidden');
      if (loading) {
        loading.classList.remove('hidden');
        loading.classList.add('inline-flex');
      }
      submit.disabled = true;
      form.setAttribute('aria-busy', 'true');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.reset();
          if (success) {
            success.classList.remove('hidden');
            success.scrollIntoView({ behavior: 'smooth', block: 'center' });
            setTimeout(() => success.classList.add('hidden'), 8000);
          }
        } else {
          throw new Error(`HTTP ${res.status}`);
        }
      } catch {
        error?.classList.remove('hidden');
      } finally {
        if (label) label.classList.remove('hidden');
        if (loading) {
          loading.classList.add('hidden');
          loading.classList.remove('inline-flex');
        }
        submit.disabled = false;
        form.removeAttribute('aria-busy');
      }
    });
  }
</script>
