---
import Section from '~/components/ui/Section.astro';
import Tag from '~/components/ui/Tag.astro';
import expEn from '~/data/en/experience.json';
import expId from '~/data/id/experience.json';
import { translations } from '~/lib/translations';

interface Props {
  locale: 'en' | 'id';
}

const { locale } = Astro.props;
const experience = locale === 'id' ? expId.experience : expEn.experience;
const t = translations[locale];
---

<Section
  id="experience"
  title={t.experience}
  subtitle={t.experienceSubtitle}
>
  <div x-data="{ activeFilter: 'all' }">
    <!-- Filter Tabs Buttons -->
    <div class="mb-10 flex flex-wrap items-center gap-2">
      <button
        type="button"
        x-on:click="activeFilter = 'all'"
        x-bind:class="activeFilter === 'all' ? 'bg-accent text-zinc-950 font-semibold' : 'border border-subtle bg-elevated text-secondary hover:border-accent hover:text-primary'"
        class="rounded-lg px-4 py-2 text-sm transition-all duration-200"
      >
        {t.all}
      </button>
      <button
        type="button"
        x-on:click="activeFilter = 'work'"
        x-bind:class="activeFilter === 'work' ? 'bg-accent text-zinc-950 font-semibold' : 'border border-subtle bg-elevated text-secondary hover:border-accent hover:text-primary'"
        class="rounded-lg px-4 py-2 text-sm transition-all duration-200"
      >
        {t.filterWork}
      </button>
      <button
        type="button"
        x-on:click="activeFilter = 'organization'"
        x-bind:class="activeFilter === 'organization' ? 'bg-accent text-zinc-950 font-semibold' : 'border border-subtle bg-elevated text-secondary hover:border-accent hover:text-primary'"
        class="rounded-lg px-4 py-2 text-sm transition-all duration-200"
      >
        {t.filterOrganization}
      </button>
    </div>

    <ol class="relative space-y-12 border-l border-subtle pl-8 md:pl-12">
      {
        experience.map((entry) => (
          <li
            x-show={`activeFilter === 'all' || activeFilter === '${entry.category}'`}
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-data
            x-intersect.once="$el.classList.add('is-visible')"
            class="reveal relative group -ml-4 p-4 rounded-xl transition-all duration-300 hover:bg-elevated/50 hover:shadow-sm"
          >
          <span
            class="absolute -left-[1.375rem] top-5 inline-block h-3 w-3 rounded-full bg-accent ring-4 ring-base transition-transform duration-300 group-hover:scale-150 group-hover:ring-accent/20 md:-left-[2.375rem]"
            aria-hidden="true"
          />
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4 mt-1">
            <h3 class="text-lg font-semibold text-primary">
              {entry.role}
              <span class="font-normal text-muted"> @ </span>
              {entry.link ? (
                <a
                  href={entry.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary transition-colors hover:text-accent"
                >
                  {entry.company}
                </a>
              ) : (
                <span class="text-primary">{entry.company}</span>
              )}
            </h3>
            <p class="whitespace-nowrap text-sm text-muted">
              {entry.startDate} — {entry.endDate || t.present}
            </p>
          </div>
          {entry.location && (
            <p class="mt-1 text-sm text-muted">{entry.location}</p>
          )}
          <p class="mt-3 text-secondary">{entry.description}</p>
          {entry.highlights && entry.highlights.length > 0 && (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-secondary marker:text-muted">
              {entry.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
          {entry.tech && entry.tech.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {entry.tech.map((t) => (
                <Tag>{t}</Tag>
              ))}
            </div>
          )}
          </li>
        ))
      }
    </ol>
  </div>
</Section>
