---
import Section from '~/components/ui/Section.astro';
import Tag from '~/components/ui/Tag.astro';
import { experience } from '~/data/experience';
---

<Section
  id="experience"
  title="Experience"
  subtitle="Where I've worked and what I shipped."
>
  <ol class="relative space-y-12 border-l border-subtle pl-8 md:pl-12">
    {
      experience.map((entry) => (
        <li
          x-data
          x-intersect.once="$el.classList.add('is-visible')"
          class="reveal relative"
        >
          <span
            class="absolute -left-[2.05rem] top-1.5 inline-block h-3 w-3 rounded-full bg-accent ring-4 ring-base md:-left-[3.05rem]"
            aria-hidden="true"
          />
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <h3 class="text-lg font-semibold text-white">
              {entry.role}
              <span class="font-normal text-zinc-500"> @ </span>
              {entry.link ? (
                <a
                  href={entry.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white transition-colors hover:text-accent"
                >
                  {entry.company}
                </a>
              ) : (
                <span class="text-white">{entry.company}</span>
              )}
            </h3>
            <p class="whitespace-nowrap text-sm text-zinc-600">
              {entry.startDate} — {entry.endDate ?? 'Present'}
            </p>
          </div>
          {entry.location && (
            <p class="mt-1 text-sm text-zinc-600">{entry.location}</p>
          )}
          <p class="mt-3 text-zinc-400">{entry.description}</p>
          {entry.highlights && entry.highlights.length > 0 && (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-zinc-400 marker:text-zinc-600">
              {entry.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
          {entry.tech && entry.tech.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {entry.tech.map((t) => (
                <Tag>{t}</Tag>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ol>
</Section>
