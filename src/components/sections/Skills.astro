---
import { Icon } from 'astro-icon/components';
import Section from '~/components/ui/Section.astro';
import skillsEn from '~/data/en/skills.json';
import skillsId from '~/data/id/skills.json';
import { translations } from '~/lib/translations';

interface Props {
  locale: 'en' | 'id';
}

const { locale } = Astro.props;
const skillGroups = locale === 'id' ? skillsId.skillGroups : skillsEn.skillGroups;
const t = translations[locale];

const colorMap: Record<string, { border: string; glow: string; icon: string; tag: string; tagHover: string }> = {
  blue: {
    border: 'hover:border-blue-500/60',
    glow: 'group-hover:shadow-blue-500/20',
    icon: 'text-blue-600 dark:text-blue-400',
    tag: 'bg-blue-500/10 border-blue-500/30 text-blue-600 dark:text-blue-300',
    tagHover: 'hover:bg-blue-500/20 hover:border-blue-400/50',
  },
  purple: {
    border: 'hover:border-purple-500/60',
    glow: 'group-hover:shadow-purple-500/20',
    icon: 'text-purple-600 dark:text-purple-400',
    tag: 'bg-purple-500/10 border-purple-500/30 text-purple-600 dark:text-purple-300',
    tagHover: 'hover:bg-purple-500/20 hover:border-purple-400/50',
  },
  green: {
    border: 'hover:border-emerald-500/60',
    glow: 'group-hover:shadow-emerald-500/20',
    icon: 'text-emerald-600 dark:text-emerald-400',
    tag: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-300',
    tagHover: 'hover:bg-emerald-500/20 hover:border-emerald-400/50',
  },
  pink: {
    border: 'hover:border-pink-500/60',
    glow: 'group-hover:shadow-pink-500/20',
    icon: 'text-pink-600 dark:text-pink-400',
    tag: 'bg-pink-500/10 border-pink-500/30 text-pink-600 dark:text-pink-300',
    tagHover: 'hover:bg-pink-500/20 hover:border-pink-400/50',
  },
  orange: {
    border: 'hover:border-orange-500/60',
    glow: 'group-hover:shadow-orange-500/20',
    icon: 'text-orange-600 dark:text-orange-400',
    tag: 'bg-orange-500/10 border-orange-500/30 text-orange-600 dark:text-orange-300',
    tagHover: 'hover:bg-orange-500/20 hover:border-orange-400/50',
  },
};
---

<Section
  id="skills"
  title={t.skills}
  subtitle={t.skillsSubtitle}
>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
    {
      skillGroups.map((group) => {
        const c = colorMap[group.color] ?? colorMap['blue'];
        return (
          <div
            x-data
            x-intersect.once="$el.classList.add('is-visible')"
            class={`reveal group relative flex flex-col overflow-hidden rounded-xl border border-subtle bg-elevated p-5 transition-all duration-300 ${c.border} hover:shadow-lg ${c.glow}`}
          >
            {/* Subtle glow background */}
            <div class="pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style={`background: radial-gradient(ellipse at top left, ${
                group.color === 'blue' ? 'rgba(59,130,246,0.07)' :
                group.color === 'purple' ? 'rgba(168,85,247,0.07)' :
                group.color === 'green' ? 'rgba(16,185,129,0.07)' :
                group.color === 'pink' ? 'rgba(236,72,153,0.07)' :
                'rgba(249,115,22,0.07)'
              } 0%, transparent 70%)`}
            />

            {/* Header */}
            <div class="mb-4 flex items-center gap-3">
              <div class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-subtle bg-base ${c.icon} transition-transform duration-300 group-hover:scale-110`}>
                <Icon name={group.icon} width={18} height={18} aria-hidden="true" />
              </div>
              <h3 class="text-sm font-semibold tracking-wide text-primary">
                {group.category}
              </h3>
            </div>

            {/* Skills */}
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span
                  class={`inline-flex cursor-default items-center rounded-md border px-2.5 py-1 font-mono text-xs font-medium transition-all duration-200 ${c.tag} ${c.tagHover} hover:scale-105`}
                >
                  {skill.name}
                </span>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</Section>
