---
import Section from '~/components/ui/Section.astro';
import ContactForm from '~/components/ContactForm.astro';
import { FORMSPREE_ENDPOINT } from '~/consts';
import { profile } from '~/data/profile';
---

<Section
  id="contact"
  title="Get in Touch"
  subtitle="Have a project, a question, or just want to say hi? Drop a message below."
>
  <div class="grid gap-12 md:grid-cols-5">
    <div class="reveal md:col-span-3">
      <ContactForm endpoint={FORMSPREE_ENDPOINT} email={profile.email} />
    </div>
    <aside class="reveal space-y-8 md:col-span-2">
      <div>
        <h3
          class="text-xs font-semibold uppercase tracking-wider text-muted"
        >
          Or reach me directly
        </h3>
        <a
          href={`mailto:${profile.email}`}
          class="mt-2 inline-flex break-all text-lg text-primary transition-colors hover:text-accent"
        >
          {profile.email}
        </a>
      </div>
      <div>
        <h3
          class="text-xs font-semibold uppercase tracking-wider text-muted"
        >
          Find me online
        </h3>
        <ul class="mt-3 space-y-2">
          <li>
            <a
              href={profile.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-secondary transition-colors hover:text-primary"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href={profile.socials.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-secondary transition-colors hover:text-primary"
            >
              LinkedIn
            </a>
          </li>
          {
            profile.socials.twitter && (
              <li>
                <a
                  href={profile.socials.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-secondary transition-colors hover:text-primary"
                >
                  Twitter
                </a>
              </li>
            )
          }
        </ul>
      </div>
      <p class="text-xs text-muted">
        I never share your info. Form powered by Formspree.
      </p>
    </aside>
  </div>
</Section>
