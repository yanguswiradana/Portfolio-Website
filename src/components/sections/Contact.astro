---
import Section from '~/components/ui/Section.astro';
import ContactForm from '~/components/ContactForm.astro';
import { FORMSPREE_ENDPOINT } from '~/consts';
import { profile } from '~/data/profile';
---

<Section
  id="contact"
  title="Get in Touch"
  subtitle="Have a project, a question, or just want to say hi? Drop a message below."
>
  <div class="grid gap-12 md:grid-cols-5">
    <div
      x-data
      x-intersect.once="$el.classList.add('is-visible')"
      class="reveal md:col-span-3"
    >
      <ContactForm endpoint={FORMSPREE_ENDPOINT} email={profile.email} />
    </div>
    <aside
      x-data
      x-intersect.once="$el.classList.add('is-visible')"
      class="reveal space-y-8 md:col-span-2"
    >
      <div x-data="{ copied: false }">
        <h3
          class="text-xs font-semibold uppercase tracking-wider text-muted"
        >
          Or reach me directly
        </h3>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <a
            href={`mailto:${profile.email}`}
            class="inline-flex break-all text-lg text-primary transition-colors hover:text-accent"
          >
            {profile.email}
          </a>
          <button
            type="button"
            x-on:click="navigator.clipboard.writeText(`${profile.email}`).then(() => { copied = true; setTimeout(() => copied = false, 2000) })"
            class="inline-flex items-center gap-1.5 rounded-lg border border-subtle bg-elevated px-3 py-1.5 text-xs text-zinc-400 transition-all hover:border-white/20 hover:text-white"
            title="Copy email"
          >
            <span x-show="!copied">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </span>
            <span x-show="copied">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span x-text="copied ? 'Copied!' : 'Copy'"></span>
          </button>
        </div>
      </div>
      <div>
        <h3
          class="text-xs font-semibold uppercase tracking-wider text-muted"
        >
          Find me online
        </h3>
        <ul class="mt-3 space-y-2">
          <li>
            <a
              href={profile.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-400 transition-colors hover:text-white"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href={profile.socials.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-400 transition-colors hover:text-white"
            >
              LinkedIn
            </a>
          </li>
          {
            profile.socials.twitter && (
              <li>
                <a
                  href={profile.socials.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-zinc-400 transition-colors hover:text-white"
                >
                  X (Twitter)
                </a>
              </li>
            )
          }
          {
            profile.socials.instagram && (
              <li>
                <a
                  href={profile.socials.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-zinc-400 transition-colors hover:text-white"
                >
                  Instagram
                </a>
              </li>
            )
          }
        </ul>
      </div>
      <p class="text-xs text-muted">
        I never share your info. Form powered by Formspree.
      </p>
    </aside>
  </div>
</Section>
