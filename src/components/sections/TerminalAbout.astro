---
import profileEn from '~/data/en/profile.json';
import profileId from '~/data/id/profile.json';
import { translations } from '~/lib/translations';

interface Props {
  locale: 'en' | 'id';
}

const { locale } = Astro.props;
const profile = locale === 'id' ? profileId : profileEn;
const t = translations[locale];

const facts = [
  { label: 'location', value: profile.location },
  { label: t.focus.toLowerCase(), value: profile.focus },
  { label: t.currently.toLowerCase(), value: profile.currently },
];
---

<section class="t-wrap t-section" id="about" aria-labelledby="about-heading">
  <h2 id="about-heading"><span class="t-prompt">$</span> cat about.txt</h2>
  <p class="t-out">{profile.bio}</p>
  <dl class="t-sysinfo">
    {facts.map((f) => (
      <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
    ))}
  </dl>
  <p class="t-links-row">
    <a href={profile.socials.github} target="_blank" rel="noopener noreferrer">github</a>
    <a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer">linkedin</a>
    {profile.socials.twitter && (
      <a href={profile.socials.twitter} target="_blank" rel="noopener noreferrer">x</a>
    )}
    {profile.socials.instagram && (
      <a href={profile.socials.instagram} target="_blank" rel="noopener noreferrer">instagram</a>
    )}
  </p>
</section>
