---
import { getCollection } from 'astro:content';
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import { translations } from '~/lib/translations';

interface Props {
  locale: 'en' | 'id';
}

const { locale } = Astro.props;
const t = translations[locale];

const posts = (await getCollection('posts')).filter(
  (post) => post.data.locale === locale
);

// Get latest 3 posts
const latest = posts
  .sort(
    (a, b) =>
      new Date(b.data.publishedDate).getTime() -
      new Date(a.data.publishedDate).getTime()
  )
  .slice(0, 3);
---

<Section id="blog" title={t.blog} subtitle={t.blogSubtitle}>
  {
    latest.length === 0 ? (
      <p class="text-secondary">{t.emptyBlog}</p>
    ) : (
      <div class="space-y-12">
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {latest.map((post) => (
            <article
              x-data
              x-intersect.once="$el.classList.add('is-visible')"
              class="reveal group flex flex-col overflow-hidden rounded-lg border border-subtle bg-elevated transition-all duration-200 hover:-translate-y-1 hover:border-accent/50"
            >
              {post.data.coverImage && (
                <div class="aspect-video w-full overflow-hidden bg-base">
                  <img
                    src={post.data.coverImage}
                    alt={`Cover for ${post.data.title}`}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <p class="text-xs text-muted">
                  {new Date(post.data.publishedDate).toLocaleDateString(
                    locale === 'id' ? 'id-ID' : 'en-US',
                    {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    }
                  )}
                </p>
                <h3 class="mt-2 text-lg font-semibold text-primary transition-colors group-hover:text-accent">
                  <a href={locale === 'id' ? `/id/blog/${post.id}` : `/blog/${post.id}`}>
                    {post.data.title}
                  </a>
                </h3>
                <p class="mt-2 flex-1 text-sm text-secondary line-clamp-2">
                  {post.data.summary}
                </p>
                <div class="mt-4 border-t border-subtle pt-4">
                  <a
                    href={locale === 'id' ? `/id/blog/${post.id}` : `/blog/${post.id}`}
                    class="inline-flex items-center gap-1 text-sm font-medium text-accent hover:underline"
                  >
                    {t.readMore} →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div
          x-data
          x-intersect.once="$el.classList.add('is-visible')"
          class="reveal flex justify-center"
        >
          <Button href={locale === 'id' ? '/id/blog' : '/blog'} variant="secondary">
            {t.viewAllPosts}
          </Button>
        </div>
      </div>
    )
  }
</Section>
