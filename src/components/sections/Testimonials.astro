---
import Section from '~/components/ui/Section.astro';
import { Icon } from 'astro-icon/components';
import testimonialsData from '~/data/testimonials.json';

const { testimonials } = testimonialsData;
---

<Section id="testimonials" title="Kind Words">
  <div class="grid gap-6 md:grid-cols-2">
    {testimonials.map((t, i) => (
      <div
        x-data
        x-intersect.once="$el.classList.add('is-visible')"
        class="reveal group relative flex flex-col gap-5 overflow-hidden rounded-2xl border border-subtle bg-elevated p-7 transition-all duration-300 hover:-translate-y-1 hover:border-white/10 hover:shadow-xl hover:shadow-black/30"
      >
        {/* Quotation mark watermark */}
        <span
          class="pointer-events-none absolute -right-2 -top-4 select-none text-9xl font-serif leading-none text-white/[0.03]"
          aria-hidden="true"
        >
          "
        </span>

        {/* Stars */}
        <div class="flex gap-0.5" aria-label="5 stars">
          {[...Array(5)].map(() => (
            <Icon name="lucide:star" width={14} height={14} class="fill-amber-400 text-amber-400" aria-hidden="true" />
          ))}
        </div>

        {/* Quote */}
        <blockquote class="flex-1 text-sm leading-relaxed text-zinc-400">
          "{t.content}"
        </blockquote>

        {/* Author */}
        <div class="flex items-center gap-3 border-t border-subtle pt-4">
          {/* Avatar initials */}
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent/20 text-sm font-bold text-accent">
            {t.name.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
          </div>
          <div>
            {t.link ? (
              <a
                href={t.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-semibold text-white transition-colors hover:text-accent"
              >
                {t.name}
              </a>
            ) : (
              <p class="text-sm font-semibold text-white">{t.name}</p>
            )}
            <p class="text-xs text-zinc-500">{t.role} · {t.company}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</Section>
