---
import Section from '~/components/ui/Section.astro';
import SocialIcon from '~/components/ui/SocialIcon.astro';
import { profile } from '~/data/profile';

const facts = [
  { label: 'Location', value: profile.location },
  { label: 'Focus', value: profile.focus },
  { label: 'Currently', value: profile.currently },
];

const socials = [
  { name: 'github',    href: profile.socials.github,    label: 'GitHub' },
  { name: 'linkedin',  href: profile.socials.linkedin,  label: 'LinkedIn' },
  { name: 'x',        href: profile.socials.twitter,   label: 'X (Twitter)' },
  { name: 'instagram', href: profile.socials.instagram, label: 'Instagram' },
];
---

<Section id="about" title="About">
  <div class="grid gap-10 md:grid-cols-3">
    <!-- Bio -->
    <div
      x-data
      x-intersect.once="$el.classList.add('is-visible')"
      class="reveal md:col-span-2 space-y-6"
    >
      <p class="text-lg leading-relaxed text-zinc-400">{profile.bio}</p>

      <!-- Social Links -->
      <div class="flex items-center gap-4 pt-2">
        {socials.map((s) => (
          <SocialIcon
            name={s.name}
            href={s.href}
            label={s.label}
            size={22}
            pack="simple-icons"
          />
        ))}
      </div>
    </div>

    <!-- Info Cards -->
    <aside class="space-y-3">
      {
        facts.map((fact) => (
          <div
            x-data
            x-intersect.once="$el.classList.add('is-visible')"
            class="reveal rounded-xl border border-subtle bg-elevated p-4"
          >
            <p class="text-xs font-medium uppercase tracking-wider text-zinc-600">
              {fact.label}
            </p>
            <p class="mt-1 text-sm text-white">{fact.value}</p>
          </div>
        ))
      }
    </aside>
  </div>
</Section>
