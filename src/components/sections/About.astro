---
import Section from '~/components/ui/Section.astro';
import SocialIcon from '~/components/ui/SocialIcon.astro';
import profileEn from '~/data/en/profile.json';
import profileId from '~/data/id/profile.json';
import { translations } from '~/lib/translations';

interface Props {
  locale: 'en' | 'id';
}

const { locale } = Astro.props;
const profile = locale === 'id' ? profileId : profileEn;
const t = translations[locale];

const facts = [
  { label: t.location, value: profile.location },
  { label: t.focus, value: profile.focus },
  { label: t.currently, value: profile.currently },
];

const socials = [
  { name: 'github',    href: profile.socials.github,    label: 'GitHub' },
  { name: 'linkedin',  href: profile.socials.linkedin,  label: 'LinkedIn' },
  { name: 'x',        href: profile.socials.twitter,   label: 'X (Twitter)' },
  { name: 'instagram', href: profile.socials.instagram, label: 'Instagram' },
];
---

<Section id="about" title={t.about}>
  <div class="grid gap-10 md:grid-cols-3">
    <!-- Bio -->
    <div
      x-data
      x-intersect.once="$el.classList.add('is-visible')"
      class="reveal md:col-span-2 space-y-6"
    >
      <p class="text-lg leading-relaxed text-secondary">{profile.bio}</p>

      <!-- Social Links -->
      <div class="flex items-center gap-4 pt-2">
        {socials.map((s) => (
          <SocialIcon
            name={s.name}
            href={s.href}
            label={s.label}
            size={22}
            pack="simple-icons"
          />
        ))}
      </div>
    </div>

    <!-- Info Cards -->
    <aside class="space-y-3">
      {
        facts.map((fact) => (
          <div
            x-data
            x-intersect.once="$el.classList.add('is-visible')"
            class="reveal rounded-xl border border-subtle bg-elevated p-4"
          >
            <p class="text-xs font-medium uppercase tracking-wider text-muted">
              {fact.label}
            </p>
            <p class="mt-1 text-sm text-primary">{fact.value}</p>
          </div>
        ))
      }
    </aside>
  </div>
</Section>
