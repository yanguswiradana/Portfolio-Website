---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import { profile } from '~/data/profile';
---

<section
  id="hero"
  class="container-page relative flex min-h-[calc(100vh-4rem)] flex-col justify-center py-20 md:py-32"
>
  <p
    class="reveal mb-4 text-sm font-medium uppercase tracking-widest text-accent"
  >
    Hi, I'm
  </p>
  <h1
    class="reveal text-5xl font-semibold tracking-tight text-primary md:text-7xl"
  >
    {profile.name}.
  </h1>
  <p
    class="reveal mt-6 max-w-2xl text-xl text-secondary md:text-2xl"
  >
    {profile.tagline}
  </p>
  <div class="reveal mt-10 flex flex-wrap items-center gap-4">
    <Button href="#projects" variant="primary" size="lg">
      View Projects
      <Icon name="lucide:arrow-right" width={18} height={18} aria-hidden="true" />
    </Button>
    <Button href={profile.resumeUrl} variant="secondary" size="lg">
      <Icon name="lucide:download" width={18} height={18} aria-hidden="true" />
      Download Resume
    </Button>
  </div>

  <a
    href="#about"
    class="reveal mt-16 hidden w-fit items-center gap-2 text-sm text-muted transition-colors hover:text-primary md:inline-flex"
    aria-label="Scroll to about section"
  >
    <span>Scroll</span>
    <Icon
      name="lucide:chevron-down"
      width={16}
      height={16}
      class="animate-bounce"
      aria-hidden="true"
    />
  </a>
</section>
