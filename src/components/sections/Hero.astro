---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import profileEn from '~/data/en/profile.json';
import profileId from '~/data/id/profile.json';
import { translations } from '~/lib/translations';

interface Props {
  locale: 'en' | 'id';
}

const { locale } = Astro.props;
const profile = locale === 'id' ? profileId : profileEn;
const t = translations[locale];
---

<section
  id="hero"
  class="relative mx-auto flex min-h-[calc(100vh-4rem)] w-full max-w-6xl flex-col justify-center px-6 py-20 md:py-32"
>
  <p
    x-data
    x-intersect.once="$el.classList.add('is-visible')"
    class="reveal mb-4 text-sm font-medium uppercase tracking-widest text-accent"
  >
    {t.hi}
  </p>
  <h1
    x-data
    x-intersect.once="$el.classList.add('is-visible')"
    class="reveal reveal-delay-100 text-5xl font-semibold tracking-tight text-primary md:text-7xl"
  >
    <span class="text-gradient-accent">{profile.name}</span>.
  </h1>
  <p
    x-data
    x-intersect.once="$el.classList.add('is-visible')"
    class="reveal reveal-delay-200 mt-6 max-w-2xl text-xl text-secondary md:text-2xl"
  >
    {profile.tagline}
  </p>
  <div
    x-data
    x-intersect.once="$el.classList.add('is-visible')"
    class="reveal reveal-delay-300 mt-10 flex flex-wrap items-center gap-4 sm:gap-6"
  >
    <Button href="#projects" variant="primary" size="lg">
      {t.viewProjects}
      <Icon name="lucide:arrow-right" width={18} height={18} aria-hidden="true" />
    </Button>
    <Button href={profile.resumeUrl} variant="secondary" size="lg">
      <Icon name="lucide:download" width={18} height={18} aria-hidden="true" />
      {t.downloadResume}
    </Button>
    <div class="flex items-center gap-4 sm:ml-2 sm:border-l sm:border-subtle sm:pl-6">
      {profile.socials.github && (
        <a href={profile.socials.github} target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent hover:scale-110 active:scale-95" aria-label="GitHub">
          <Icon name="lucide:github" width={24} height={24} aria-hidden="true" />
        </a>
      )}
      {profile.socials.linkedin && (
        <a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent hover:scale-110 active:scale-95" aria-label="LinkedIn">
          <Icon name="lucide:linkedin" width={24} height={24} aria-hidden="true" />
        </a>
      )}
    </div>
  </div>

  <a
    href="#about"
    x-data
    x-intersect.once="$el.classList.add('is-visible')"
    class="reveal reveal-delay-400 mt-16 hidden w-fit items-center gap-2 text-sm text-muted transition-colors hover:text-primary md:inline-flex"
    aria-label="Scroll to about section"
  >
    <span>{t.scroll}</span>
    <Icon
      name="lucide:chevron-down"
      width={16}
      height={16}
      class="animate-bounce"
      aria-hidden="true"
    />
  </a>
</section>
