---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import profileEn from '~/data/en/profile.json';
import profileId from '~/data/id/profile.json';
import { translations } from '~/lib/translations';

interface Props {
  locale: 'en' | 'id';
}

const { locale } = Astro.props;
const profile = locale === 'id' ? profileId : profileEn;
const t = translations[locale];
---

<section
  id="hero"
  class="relative mx-auto flex min-h-[calc(100vh-4rem)] w-full max-w-6xl flex-col justify-center px-6 py-20 md:py-32"
>
  <p
    x-data
    x-intersect.once="$el.classList.add('is-visible')"
    class="reveal mb-4 text-sm font-medium uppercase tracking-widest text-accent"
  >
    {t.hi}
  </p>
  <h1
    x-data
    x-intersect.once="$el.classList.add('is-visible')"
    class="reveal text-5xl font-semibold tracking-tight text-primary md:text-7xl"
  >
    {profile.name}.
  </h1>
  <p
    x-data
    x-intersect.once="$el.classList.add('is-visible')"
    class="reveal mt-6 max-w-2xl text-xl text-secondary md:text-2xl"
  >
    {profile.tagline}
  </p>
  <div
    x-data
    x-intersect.once="$el.classList.add('is-visible')"
    class="reveal mt-10 flex flex-wrap items-center gap-4"
  >
    <Button href="#projects" variant="primary" size="lg">
      {t.viewProjects}
      <Icon name="lucide:arrow-right" width={18} height={18} aria-hidden="true" />
    </Button>
    <Button href={profile.resumeUrl} variant="secondary" size="lg">
      <Icon name="lucide:download" width={18} height={18} aria-hidden="true" />
      {t.downloadResume}
    </Button>
  </div>

  <a
    href="#about"
    x-data
    x-intersect.once="$el.classList.add('is-visible')"
    class="reveal mt-16 hidden w-fit items-center gap-2 text-sm text-muted transition-colors hover:text-primary md:inline-flex"
    aria-label="Scroll to about section"
  >
    <span>{t.scroll}</span>
    <Icon
      name="lucide:chevron-down"
      width={16}
      height={16}
      class="animate-bounce"
      aria-hidden="true"
    />
  </a>
</section>
