---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import SocialIcon from '~/components/ui/SocialIcon.astro';
import { NAV_LINKS } from '~/lib/nav';
import profileEn from '~/data/en/profile.json';
import profileId from '~/data/id/profile.json';
import { translations } from '~/lib/translations';

interface Props {
  locale: 'en' | 'id';
}

const { locale } = Astro.props;
const profile = locale === 'id' ? profileId : profileEn;
const t = translations[locale];

const pathname = Astro.url.pathname;
// Match "/", "/id", "/id/" but not "/blog"
const isHome = pathname === '/' || pathname === '/id' || pathname === '/id/';
---

<div
  x-data="{
    scrolled: false,
    open: false,
    theme: 'dark',
    colorTheme: 'orange',
    toggleTheme() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
        this.theme = 'light';
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
        this.theme = 'dark';
      }
    },
    changeColor(color) {
      this.colorTheme = color;
      localStorage.setItem('color-theme', color);
      const themes = [...document.documentElement.classList].filter(cls => cls.startsWith('theme-'));
      themes.forEach(cls => document.documentElement.classList.remove(cls));
      if (color !== 'orange') {
        document.documentElement.classList.add(`theme-${color}`);
      }
    }
  }"
  x-init="
    theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    colorTheme = localStorage.getItem('color-theme') || 'orange';
  "
  x-on:scroll.window="scrolled = window.scrollY > 50"
  x-on:keydown.escape.window="open = false"
>
  <!-- Desktop / Main Navbar -->
  <header
    id="site-nav"
    x-bind:class="scrolled ? 'bg-base/80 backdrop-blur-md border-b border-subtle' : 'border-b border-transparent'"
    class="fixed inset-x-0 top-0 z-40 transition-all duration-300"
  >
    <nav
      class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-6"
      aria-label="Primary"
    >
      <!-- Logo -->
      <a
        href={locale === 'id' ? '/id' : '/'}
        class="flex items-center gap-2 text-sm font-semibold text-primary"
        aria-label={`${profile.name} — home`}
      >
        <span class="inline-block h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
        <span>{profile.name}</span>
      </a>

      <!-- Desktop nav links -->
      <ul class="hidden items-center gap-1 md:flex">
        {
          NAV_LINKS.map((link) => {
            const isHash = link.href.startsWith('#');
            let href = link.href;
            
            if (isHash) {
              if (isHome) {
                href = link.href;
              } else {
                href = locale === 'id' ? `/id/${link.href}` : `/${link.href}`;
              }
            } else {
              href = locale === 'id' ? `/id${link.href}` : link.href;
            }

            return (
              <li>
                <a
                  href={href}
                  data-nav-link
                  data-astro-reload={!isHome && isHash ? '' : undefined}
                  class="relative rounded-md px-3 py-2 text-sm text-secondary transition-colors hover:text-primary after:absolute after:-bottom-1 after:left-3 after:h-px after:w-0 after:bg-accent after:transition-all after:duration-300 hover:after:w-[calc(100%-1.5rem)]"
                >
                  {t[link.key]}
                </a>
              </li>
            );
          })
        }
      </ul>

      <!-- Right side actions -->
      <div class="flex items-center gap-2">
        <!-- Language Switcher -->
        <a
          href={locale === 'en' ? '/id' : '/'}
          class="inline-flex items-center gap-1.5 rounded-lg border border-subtle bg-elevated px-3 py-1.5 text-xs font-semibold text-secondary transition-all hover:border-accent hover:text-primary"
          aria-label={locale === 'en' ? 'Switch to Indonesian' : 'Switch to English'}
        >
          <Icon name="lucide:languages" width={14} height={14} aria-hidden="true" />
          <span>{locale === 'en' ? 'ID' : 'EN'}</span>
        </a>

        <!-- Color Theme Picker (Desktop) -->
        <div class="hidden items-center gap-1.5 mr-1 sm:flex bg-elevated border border-subtle rounded-lg px-2.5 h-8">
          <button
            type="button"
            x-on:click="changeColor('orange')"
            class="h-3 w-3 rounded-full bg-[#ff5500] ring-2 transition-all"
            x-bind:class="colorTheme === 'orange' ? 'ring-primary scale-110' : 'ring-transparent hover:scale-110'"
            title="Orange Accent"
            aria-label="Orange Accent"
          ></button>
          <button
            type="button"
            x-on:click="changeColor('blue')"
            class="h-3 w-3 rounded-full bg-[#0055ff] ring-2 transition-all"
            x-bind:class="colorTheme === 'blue' ? 'ring-primary scale-110' : 'ring-transparent hover:scale-110'"
            title="Blue Accent"
            aria-label="Blue Accent"
          ></button>
          <button
            type="button"
            x-on:click="changeColor('emerald')"
            class="h-3 w-3 rounded-full bg-[#00a86b] ring-2 transition-all"
            x-bind:class="colorTheme === 'emerald' ? 'ring-primary scale-110' : 'ring-transparent hover:scale-110'"
            title="Emerald Accent"
            aria-label="Emerald Accent"
          ></button>
          <button
            type="button"
            x-on:click="changeColor('purple')"
            class="h-3 w-3 rounded-full bg-[#8800ff] ring-2 transition-all"
            x-bind:class="colorTheme === 'purple' ? 'ring-primary scale-110' : 'ring-transparent hover:scale-110'"
            title="Purple Accent"
            aria-label="Purple Accent"
          ></button>
          <button
            type="button"
            x-on:click="changeColor('rose')"
            class="h-3 w-3 rounded-full bg-[#ff0055] ring-2 transition-all"
            x-bind:class="colorTheme === 'rose' ? 'ring-primary scale-110' : 'ring-transparent hover:scale-110'"
            title="Rose Accent"
            aria-label="Rose Accent"
          ></button>
        </div>

        <!-- Theme Toggle Button -->
        <button
          type="button"
          x-on:click="toggleTheme()"
          class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-subtle bg-elevated text-secondary transition-all hover:border-accent hover:text-primary"
          aria-label="Toggle theme"
        >
          <span x-show="theme === 'dark'">
            <Icon name="lucide:sun" width={15} height={15} aria-hidden="true" />
          </span>
          <span x-show="theme === 'light'" x-cloak>
            <Icon name="lucide:moon" width={15} height={15} aria-hidden="true" />
          </span>
        </button>

        <!-- Resume Button -->
        <Button
          href={profile.resumeUrl}
          variant="ghost"
          size="sm"
          class="hidden sm:inline-flex text-secondary hover:text-primary"
          aria-label="Download resume"
        >
          <Icon name="lucide:download" width={16} height={16} aria-hidden="true" />
          <span>{t.resume}</span>
        </Button>

        <!-- Hamburger (mobile) -->
        <button
          type="button"
          x-on:click="open = true"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md text-secondary transition-colors hover:text-primary md:hidden"
          aria-label="Open menu"
          x-bind:aria-expanded="open"
        >
          <Icon name="lucide:menu" width={22} height={22} aria-hidden="true" />
        </button>
      </div>
    </nav>
  </header>

  <!-- Mobile Menu Overlay -->
  <div
    x-cloak
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    x-on:click.self="open = false"
    class="fixed inset-0 z-50 bg-black/60 md:hidden"
    aria-hidden="true"
  ></div>

  <!-- Mobile Menu Panel -->
  <div
    x-show="open"
    x-transition:enter="transition ease-out duration-250"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    class="fixed inset-y-0 right-0 z-50 w-72 bg-elevated shadow-2xl md:hidden flex flex-col"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
  >
    <!-- Header -->
    <div class="flex h-16 items-center justify-between border-b border-subtle px-6">
      <span class="text-xs font-semibold uppercase tracking-widest text-muted">Menu</span>
      <button
        type="button"
        x-on:click="open = false"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-secondary transition-colors hover:text-primary"
        aria-label="Close menu"
      >
        <Icon name="lucide:x" width={22} height={22} aria-hidden="true" />
      </button>
    </div>

    <!-- Nav Links -->
    <nav class="flex-1 overflow-y-auto px-4 py-6" aria-label="Mobile primary">
      <ul class="space-y-1">
        {
          NAV_LINKS.map((link) => {
            const isHash = link.href.startsWith('#');
            let href = link.href;
            
            if (isHash) {
              if (isHome) {
                href = link.href;
              } else {
                href = locale === 'id' ? `/id/${link.href}` : `/${link.href}`;
              }
            } else {
              href = locale === 'id' ? `/id${link.href}` : link.href;
            }

            return (
              <li>
                <a
                  href={href}
                  x-on:click="open = false"
                  data-astro-reload={!isHome && isHash ? '' : undefined}
                  class="block rounded-lg px-4 py-3 text-base text-secondary transition-colors hover:bg-subtle hover:text-primary"
                >
                  {t[link.key]}
                </a>
              </li>
            );
          })
        }
        <li>
          <a
            href={profile.resumeUrl}
            x-on:click="open = false"
            class="flex items-center gap-2 rounded-lg px-4 py-3 text-base text-secondary transition-colors hover:bg-subtle hover:text-primary"
          >
            <Icon name="lucide:download" width={18} height={18} aria-hidden="true" />
            <span>{t.downloadResume}</span>
          </a>
        </li>
        <li>
          <button
            type="button"
            x-on:click="toggleTheme()"
            class="flex w-full items-center gap-2 rounded-lg px-4 py-3 text-base text-secondary transition-colors hover:bg-subtle hover:text-primary"
          >
            <span x-show="theme === 'dark'" class="flex items-center gap-2">
              <Icon name="lucide:sun" width={18} height={18} aria-hidden="true" />
              <span>Light Mode</span>
            </span>
            <span x-show="theme === 'light'" class="flex items-center gap-2" x-cloak>
              <Icon name="lucide:moon" width={18} height={18} aria-hidden="true" />
              <span>Dark Mode</span>
            </span>
          </button>
        </li>
        <li class="px-4 py-3 border-t border-subtle/30 mt-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-muted block mb-2">Accent Color</span>
          <div class="flex items-center gap-3">
            <button
              type="button"
              x-on:click="changeColor('orange')"
              class="h-6 w-6 rounded-full bg-[#ff5500] ring-2 transition-all flex items-center justify-center text-zinc-950 font-bold text-xs"
              x-bind:class="colorTheme === 'orange' ? 'ring-primary scale-110' : 'ring-transparent'"
              aria-label="Orange Accent"
            >
              <span x-show="colorTheme === 'orange'">✓</span>
            </button>
            <button
              type="button"
              x-on:click="changeColor('blue')"
              class="h-6 w-6 rounded-full bg-[#0055ff] ring-2 transition-all flex items-center justify-center text-white font-bold text-xs"
              x-bind:class="colorTheme === 'blue' ? 'ring-primary scale-110' : 'ring-transparent'"
              aria-label="Blue Accent"
            >
              <span x-show="colorTheme === 'blue'">✓</span>
            </button>
            <button
              type="button"
              x-on:click="changeColor('emerald')"
              class="h-6 w-6 rounded-full bg-[#00a86b] ring-2 transition-all flex items-center justify-center text-white font-bold text-xs"
              x-bind:class="colorTheme === 'emerald' ? 'ring-primary scale-110' : 'ring-transparent'"
              aria-label="Emerald Accent"
            >
              <span x-show="colorTheme === 'emerald'">✓</span>
            </button>
            <button
              type="button"
              x-on:click="changeColor('purple')"
              class="h-6 w-6 rounded-full bg-[#8800ff] ring-2 transition-all flex items-center justify-center text-white font-bold text-xs"
              x-bind:class="colorTheme === 'purple' ? 'ring-primary scale-110' : 'ring-transparent'"
              aria-label="Purple Accent"
            >
              <span x-show="colorTheme === 'purple'">✓</span>
            </button>
            <button
              type="button"
              x-on:click="changeColor('rose')"
              class="h-6 w-6 rounded-full bg-[#ff0055] ring-2 transition-all flex items-center justify-center text-white font-bold text-xs"
              x-bind:class="colorTheme === 'rose' ? 'ring-primary scale-110' : 'ring-transparent'"
              aria-label="Rose Accent"
            >
              <span x-show="colorTheme === 'rose'">✓</span>
            </button>
          </div>
        </li>
      </ul>
    </nav>

    <!-- Social Links -->
    <div class="flex items-center gap-4 border-t border-subtle px-6 py-5">
      <SocialIcon name="github" href={profile.socials.github} label="GitHub" size={22} pack="simple-icons" />
      <SocialIcon name="linkedin" href={profile.socials.linkedin} label="LinkedIn" size={22} pack="simple-icons" />
      {
        profile.socials.twitter && (
          <SocialIcon name="x" href={profile.socials.twitter} label="X (Twitter)" size={22} pack="simple-icons" />
        )
      }
      {
        profile.socials.instagram && (
          <SocialIcon name="instagram" href={profile.socials.instagram} label="Instagram" size={22} pack="simple-icons" />
        )
      }
      <span class="ml-auto text-xs text-muted">© {new Date().getFullYear()}</span>
    </div>
  </div>
</div>
