---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import SocialIcon from '~/components/ui/SocialIcon.astro';
import { NAV_LINKS } from '~/lib/nav';
import { profile } from '~/data/profile';
---

<div
  x-data="{ scrolled: false, open: false }"
  @scroll.window="scrolled = window.scrollY > 50"
  @keydown.escape.window="open = false"
>
  <!-- Desktop / Main Navbar -->
  <header
    id="site-nav"
    :class="scrolled ? 'bg-base/80 backdrop-blur-md border-b border-subtle' : 'border-b border-transparent'"
    class="fixed inset-x-0 top-0 z-40 transition-all duration-300"
  >
    <nav
      class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-6"
      aria-label="Primary"
    >
      <!-- Logo -->
      <a
        href="#hero"
        class="flex items-center gap-2 text-sm font-semibold text-white"
        aria-label={`${profile.name} — home`}
      >
        <span class="inline-block h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
        <span>{profile.name}</span>
      </a>

      <!-- Desktop nav links -->
      <ul class="hidden items-center gap-1 md:flex">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link
                class="relative rounded-md px-3 py-2 text-sm text-zinc-400 transition-colors hover:text-white after:absolute after:-bottom-1 after:left-3 after:h-px after:w-0 after:bg-accent after:transition-all after:duration-300 hover:after:w-[calc(100%-1.5rem)]"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Right side actions -->
      <div class="flex items-center gap-2">
        <Button
          href={profile.resumeUrl}
          variant="ghost"
          size="sm"
          class="hidden sm:inline-flex"
          aria-label="Download resume"
        >
          <Icon name="lucide:download" width={16} height={16} aria-hidden="true" />
          <span>Resume</span>
        </Button>

        <!-- Hamburger (mobile) -->
        <button
          type="button"
          @click="open = true"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md text-zinc-400 transition-colors hover:text-white md:hidden"
          aria-label="Open menu"
          :aria-expanded="open"
        >
          <Icon name="lucide:menu" width={22} height={22} aria-hidden="true" />
        </button>
      </div>
    </nav>
  </header>

  <!-- Mobile Menu Overlay -->
  <div
    x-cloak
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click.self="open = false"
    class="fixed inset-0 z-50 bg-black/60 md:hidden"
    aria-hidden="true"
  ></div>

  <!-- Mobile Menu Panel -->
  <div
    x-cloak
    x-show="open"
    x-transition:enter="transition ease-out duration-250"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    class="fixed inset-y-0 right-0 z-50 w-72 bg-elevated shadow-2xl md:hidden flex flex-col"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
  >
    <!-- Header -->
    <div class="flex h-16 items-center justify-between border-b border-subtle px-6">
      <span class="text-xs font-semibold uppercase tracking-widest text-zinc-500">Menu</span>
      <button
        type="button"
        @click="open = false"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-zinc-400 transition-colors hover:text-white"
        aria-label="Close menu"
      >
        <Icon name="lucide:x" width={22} height={22} aria-hidden="true" />
      </button>
    </div>

    <!-- Nav Links -->
    <nav class="flex-1 overflow-y-auto px-4 py-6" aria-label="Mobile primary">
      <ul class="space-y-1">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                @click="open = false"
                class="block rounded-lg px-4 py-3 text-base text-zinc-300 transition-colors hover:bg-subtle hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={profile.resumeUrl}
            @click="open = false"
            class="mt-2 flex items-center gap-2 rounded-lg px-4 py-3 text-base text-zinc-300 transition-colors hover:bg-subtle hover:text-white"
          >
            <Icon name="lucide:download" width={18} height={18} aria-hidden="true" />
            <span>Download Resume</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Social Links -->
    <div class="flex items-center gap-4 border-t border-subtle px-6 py-5">
      <SocialIcon name="github" href={profile.socials.github} label="GitHub" size={22} />
      <SocialIcon name="linkedin" href={profile.socials.linkedin} label="LinkedIn" size={22} />
      {
        profile.socials.twitter && (
          <SocialIcon name="twitter" href={profile.socials.twitter} label="Twitter" size={22} />
        )
      }
      <span class="ml-auto text-xs text-zinc-600">© {new Date().getFullYear()}</span>
    </div>
  </div>
</div>
