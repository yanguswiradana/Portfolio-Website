---
import { cn } from '~/lib/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class={cn(
    'inline-flex items-center rounded-sm border border-subtle bg-base/50 px-2.5 py-0.5 font-mono text-xs text-secondary',
    className
  )}
>
  <slot />
</span>
